{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "popoto-memory hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "popoto-memory hook",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}

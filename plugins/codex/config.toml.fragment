# Append to ~/.codex/config.toml. Two separate things are needed: the
# feature flag that turns hooks on at all, and the MCP server registration.

[features]
hooks = true

[mcp_servers.popoto-memory]
command = "popoto-memory"
args = ["mcp"]

# Optional, except the database: agent memory refuses to write to Redis
# database 0, so on a default install set POPOTO_MEMORY_URL (or REDIS_URL)
# at some other database. See docs/features/harness-integration.md.
# [mcp_servers.popoto-memory.env_vars]
# POPOTO_MEMORY_URL = "redis://localhost:6379/1"
# POPOTO_MEMORY_AGENT_ID = "my-project"
